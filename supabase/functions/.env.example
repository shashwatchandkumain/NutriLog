# Edge Function secrets for NutriLog.
#
# Copy this file to supabase/functions/.env (git-ignored), fill in your real keys, then run:
#   supabase secrets set --env-file supabase/functions/.env
# or add each one in: Supabase Dashboard → Edge Functions → Secrets.
#
# NEVER put these values in index.html, js/, manifest.json or anywhere under GitHub Pages.

# Google Gemini (https://aistudio.google.com/apikey) — used for food photo/text analysis by default
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Anthropic Claude (https://console.anthropic.com/) — used for the AI coach chat by default
CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY_HERE

# Optional settings (defaults shown)
# AI_FOOD_PROVIDER=gemini            # gemini | claude — the other one is used as a fallback
# AI_CHAT_PROVIDER=claude            # gemini | claude
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# CLAUDE_MODEL=claude-opus-5-5
# AI_HOURLY_LIMIT=30                 # AI requests per user per hour
# AI_DAILY_LIMIT=150                 # AI requests per user per day
# ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io   # sites allowed to call the functions (comma-separated; default: NutriLog's GitHub Pages site)

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions
# automatically by Supabase — do not set them yourself.

# ── Payments (Razorpay) — see README "Turning on payments" ──
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Phone verification on WhatsApp — see README "Turning on phone verification" ──
# WHATSAPP_TOKEN=YOUR_META_SYSTEM_USER_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# WHATSAPP_TEMPLATE=nutrilog_otp
# WHATSAPP_TEMPLATE_LANG=en
# SEND_SMS_HOOK_SECRETS=v1,whsec_FROM_SUPABASE_AUTH_HOOKS
# PHONE_VERIFICATION=on
